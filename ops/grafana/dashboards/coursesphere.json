{
  "uid": "coursesphere-v6",
  "title": "CourseSphere | AppSec & SRE",
  "tags": [
    "coursesphere",
    "appsec",
    "sre"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Live replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "coursesphere-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"coursesphere-demo\"})"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx ratio (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "coursesphere-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(coursesphere_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(coursesphere_http_requests_total[5m])), 0.001)"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests/sec by instance",
      "datasource": {
        "type": "prometheus",
        "uid": "coursesphere-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance)(rate(coursesphere_http_requests_total[1m]))"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 API duration",
      "datasource": {
        "type": "prometheus",
        "uid": "coursesphere-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coursesphere_http_duration_seconds_bucket[5m])))"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Session issuance p95 — SLO <300ms",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coursesphere_http_duration_seconds_bucket{route=\"/api/demo/session\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Course CRUD successful requests — SLO >99%",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(coursesphere_http_requests_total{route=~\"/api/courses.*\",status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(coursesphere_http_requests_total{route=~\"/api/courses.*\"}[5m])), 0.001))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {}
    }
  ]
}
