# Offline-friendly build after dependencies have been cached; requires npm registry
# access when building the image for the first time. Never includes upstream keys.
FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ARG VITE_USE_FIREBASE_EMULATORS=true
ENV VITE_USE_FIREBASE_EMULATORS=$VITE_USE_FIREBASE_EMULATORS
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY ops/nginx/nginx.conf /etc/nginx/nginx.conf
COPY ops/nginx/frontend.official.conf /etc/nginx/conf.d/default.conf
USER nginx
EXPOSE 8082
HEALTHCHECK --interval=25s --timeout=4s --start-period=5s \
    CMD wget -q -O /dev/null http://127.0.0.1:8082/ || exit 1
